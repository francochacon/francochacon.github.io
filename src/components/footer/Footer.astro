---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="section-footer">
  <div class="container-footer">
    <h2 class="title-contact" id="contact">{t("footer.title")}</h2>
    <p class="subtitle-contact">{t("footer.subtitle")}</p>

    <ul class="container-redes">
      <li>
        <a href="https://wa.me/+543875633214" target="_blank" class="contact-card">
          <i class="fa-brands fa-whatsapp icon-whatsapp"></i>
          <span>Whatsapp</span>
        </a>
      </li>

      <li>
        <a href="https://github.com/francochacon" target="_blank" class="contact-card">
          <i class="fa-brands fa-github"></i>
          <span>Github</span>
        </a>
      </li>

      <li>
        <a href="https://www.linkedin.com/in/francochacon/" target="_blank" class="contact-card">
          <i class="fa-brands fa-linkedin"></i>
          <span>Linkedin</span>
        </a>
      </li>
    </ul>

    <div class="footer-divider"></div>

    <p class="container-copy">{t("footer.copy")}</p>
  </div>
</footer>

<style>
  .section-footer {
    position: relative;
    width: 100%;
    background-color: #000;
    overflow: hidden;
  }

  .container-footer {
    position: relative;
    z-index: 1;
    width: 90%;
    margin: 0 auto;
    padding: 50px 0 24px;
    max-width: 1355px;
  }

  .title-contact {
    color: #f6f6f9;
    font-size: 27px;
    font-weight: 800;
    scroll-margin-top: 80px;
  }

  .subtitle-contact {
    color: #a0a0a0;
    font-size: 14px;
    margin-top: 8px;
    max-width: 480px;
    line-height: 1.6;
  }

  .container-redes {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 28px 0 36px;
    flex-wrap: wrap;
    list-style: none;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #f6f6f9;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(1, 190, 150, 0.3);
    border-radius: 12px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    transition: border-color 0.2s ease, transform 0.15s ease, color 0.2s ease;
  }

  .contact-card i {
    font-size: 20px;
    color: #01be96;
  }

  .contact-card:hover {
    border-color: #01be96;
    color: #01be96;
    transform: translateY(-2px);
  }

  .contact-card:hover i {
    color: #01be96;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .container-copy {
    color: #555555;
    font-size: 13px;
    padding-top: 18px;
    text-align: center;
  }
</style>
