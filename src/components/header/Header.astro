---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = (path) => (lang === "es" ? `/es${path}` : path);
const homeHref = lang === "es" ? "/es" : "/";
const projectsHref = lang === "es" ? "/es/projects" : "/projects";
const servicesHref = lang === "es" ? "/es/services" : "/services";
const otherLang = lang === "es" ? "en" : "es";
const enHref = getLocalizedPath(Astro.url.pathname, "en");
const esHref = getLocalizedPath(Astro.url.pathname, "es");
const currentFlag = lang === "es" ? "🇦🇷" : "🇺🇸";
---

<header class="header">
  <h1 id="top">{t("site.brand")}</h1>

  <nav class="nav">
    <ul class="ul-nav">
      <a href={homeHref} class="nav-home">
        <li class="li-nav">{t("nav.home")}</li>
      </a>

      <a href={projectsHref}>
        <li class="li-nav">{t("nav.projects")}</li>
      </a>

      <a href={servicesHref}>
        <li class="li-nav li-services">{t("nav.services")}</li>
      </a>

      <a class="nav-link" data-home="#about" data-project={prefix("/#about")} href="#about">
        <li class="li-nav">{t("nav.about")}</li>
      </a>

      <a class="nav-link" data-home="#contact" data-project={prefix("/#contact")} href="#contact">
        <li class="li-nav">{t("nav.contact")}</li>
      </a>

      <div class="lang-dropdown">
        <button class="lang-trigger" aria-label="Select language">
          {currentFlag}
        </button>
        <div class="lang-menu">
          <a href={enHref} class={`lang-option ${lang === "en" ? "lang-option--active" : ""}`}>
            🇺🇸 <span>English</span>
          </a>
          <a href={esHref} class={`lang-option ${lang === "es" ? "lang-option--active" : ""}`}>
            🇦🇷 <span>Español</span>
          </a>
        </div>
      </div>
    </ul>
  </nav>

  <div class="container-bnt-menu">
    <div class="btn-menu">
      <span class="linea-menu" id="linea1"></span>
      <span class="linea-menu" id="linea2"></span>
      <span class="linea-menu" id="linea3"></span>
    </div>
  </div>

  <div class="menu-drop"></div>

  <script>
    const $menu = document.querySelector(".nav");
    const $menuDrop = document.querySelector(".menu-drop");
    const $btnmenu = document.querySelector(".btn-menu");
    const $linea1 = document.querySelector("#linea1");
    const $linea2 = document.querySelector("#linea2");
    const $linea3 = document.querySelector("#linea3");

    const toggleMenu = () => {
      $linea1.classList.toggle("activelinea1__bars-menu");
      $linea2.classList.toggle("activelinea2__bars-menu");
      $linea3.classList.toggle("activelinea3__bars-menu");
      $menu.classList.toggle("menu-activado");
      $menuDrop.classList.toggle("activa-menu-drop");
    };

    $btnmenu.addEventListener("click", toggleMenu);
    $menuDrop.addEventListener("click", toggleMenu);

    const path = window.location.pathname;
    const isProjectPage = path.includes("/project");

    document.querySelectorAll(".nav-link").forEach((a) => {
      const homeHref = a.getAttribute("data-home");
      const projectHref = a.getAttribute("data-project");
      a.setAttribute("href", isProjectPage ? projectHref : homeHref);
    });

    document.querySelectorAll(".ul-nav a").forEach((a) => {
      a.addEventListener("click", () => {
        if (window.innerWidth <= 720 && $menu.classList.contains("menu-activado")) {
          toggleMenu();
        }
      });
    });
  </script>
</header>

<style is:global>
  .header {
    position: relative;
    height: 80px;
    background-color: #000;
    width: 100%;
    padding: 20px 20px;
    color: #f6f6f9;
    display: flex;
    justify-content: space-between;
    overflow: hidden;
    max-width: 1355px;
    margin: 0 auto;
  }
  .header h1 { display: inline-block; position: relative; z-index: 20; }
  .nav { position: relative; display: flex; justify-content: space-between; align-items: center; color: #f6f6f9; }
  .ul-nav { position: relative; display: flex; }
  .ul-nav a { text-decoration: none; color: #f6f6f9; }
  .li-nav {
    position: relative; list-style: none; color: #f6f6f9;
    transition: 0.3s; margin: 0 10px; padding: 4px 2px; text-align: center;
  }
  .li-nav::before {
    content: ""; position: absolute; height: 2px; width: 0%;
    background-color: #01be96; bottom: -3px;
  }
  .li-nav:hover::before { width: 100%; transition: 0.4s; }
  .li-nav:hover { color: #01be96; }
  .li-services {
    color: #01be96; font-weight: 700;
  }
  .lang-dropdown {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: 6px;
  }
  .lang-trigger {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(1,190,150,0.4);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 18px;
    cursor: pointer;
    color: #f6f6f9;
    line-height: 1;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .lang-trigger:hover {
    border-color: #01be96;
    background: rgba(1,190,150,0.1);
  }
  .lang-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: rgba(10,10,10,0.96);
    border: 1px solid rgba(1,190,150,0.25);
    border-radius: 12px;
    padding: 6px;
    min-width: 130px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    z-index: 999;
    flex-direction: column;
    gap: 2px;
  }
  .lang-dropdown:hover .lang-menu {
    display: flex;
  }
  .lang-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: #a0a0a0;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .lang-option:hover {
    background: rgba(1,190,150,0.12);
    color: #f6f6f9;
  }
  .lang-option--active {
    color: #01be96;
    background: rgba(1,190,150,0.08);
  }
  .container-bnt-menu { display: none; }
  .menu-drop { display: none; }

  @media (max-width: 720px) {
    .menu-drop { display: block; }
    .container-bnt-menu { display: block; }
    .header { position: fixed; display: flex; justify-items: center; justify-content: space-between; top: 0; left: 0; z-index: 100; }
    h1 { display: inline-block; }
    .container-bnt-menu { position: relative; padding: 0px 20px; z-index: 9999; }
    .linea-menu {
      display: block; position: relative; height: 2px; width: 40px;
      background-color: #f6f6f9; top: -5px; margin-top: 10px; cursor: pointer;
      transform-origin: 0px 100%; transition: all 0.4s;
    }
    .activelinea1__bars-menu { transform: rotate(40deg) translate(-2px, 1px); }
    .activelinea2__bars-menu { opacity: 0; margin-left: -30px; }
    .activelinea3__bars-menu { transform: rotate(-40deg) translate(-2px, 1px); }
    .nav {
      position: fixed; flex-direction: column; background: #111111;
      width: auto; height: 100vh; right: -300px; top: 80px;
      transition: right 0.4s ease-in-out; z-index: 100;
    }
    .li-nav { padding: 30px 80px; text-align: center; width: 100%; margin: 0; }
    .li-nav:hover { background-color: #01be96; color: #000; }
    .li-nav:hover::before { content: ""; width: 0; height: 0; }
    .menu-activado { right: 0px; transition: right 0.4s ease-in-out; }
    .menu-drop {
      top: 0; left: 0; position: fixed; height: 100vh; width: 100%;
      background-color: rgba(0,0,0,0.5); z-index: 20; display: none;
    }
    .activa-menu-drop { display: block; transition: 0.5s display; }
    .ul-nav { flex-direction: column; width: 100%; }
  }
</style>
