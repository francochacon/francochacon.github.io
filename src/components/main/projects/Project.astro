---
import { getIconComponent } from "../../../icons/IconAll.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

type Technology = {
  icon?: string;
};
export interface Props {
  title: string;
  images: string[];
  description: string;
  technologies?: Technology[];
  link: string;
  tags?: string[];
}
const { technologies, title, images, description, link, tags = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = lang === "es" ? `/es/${link}` : `/${link}`;
const hasMultiple = images.length > 1;
---
<li class="li-project" data-tags={tags.join(",")}>
  <div class="card-media">
    {
      images.map((src, i) => (
        <img
          src={src}
          alt={title}
          loading="lazy"
          class="card-media-img"
          data-index={i}
          style={`opacity:${i === 0 ? 1 : 0}`}
        />
      ))
    }
    {
      hasMultiple && (
        <>
          <button class="card-arrow card-arrow-left" aria-label="Previous image" type="button">‹</button>
          <button class="card-arrow card-arrow-right" aria-label="Next image" type="button">›</button>
          <div class="card-dots">
            {images.map((_, i) => <span class="card-dot" class:list={[{ active: i === 0 }]} />)}
          </div>
        </>
      )
    }
  </div>
  <p class="title-project">{title}</p>
  <p class="description-project">
    {description}
  </p>
  <p class="title-technologies">{t("projects.technologiesUsed")}</p>
  <div class="container-technologies">
    {
      technologies.map(({ icon }) => {
        const IconComponent = getIconComponent(icon);
        return <i>{IconComponent && <IconComponent />}</i>;
      })
    }
  </div>
  <div class="container-link-project">
    <a href={href}>{t("projects.viewProject")}</a>
  </div>
</li>
<style>
  .li-project {
    position: relative;
    list-style: none;
    border: 1px solid #3d3e4f;
    overflow: hidden;
    max-width: 380px;
    min-width: 300px;
    width: 100%;
    border-radius: 7px;
    transition: transform 0.3s ease;
    background-color: #25242d;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }
  .li-project::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 5px;
    background-color: rgba(0, 0, 0, 0.3);
    z-index: -1;
    bottom: 0;
    transition: 0.3s ease-in-out;
    pointer-events: none;
  }
  .li-project:hover::before {
    content: "";
    position: absolute;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    z-index: -1;
    bottom: 0;
    transition: 0.3s ease-in-out;
    pointer-events: none;
  }
  .li-project:hover {
    transform: translateY(-10px);
  }
  .card-media {
    position: relative;
    display: block;
    height: 200px;
    width: 100%;
    overflow: hidden;
  }
  .card-media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    user-select: none;
    transition: opacity 0.25s ease;
  }
  .card-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 2;
  }
  .li-project:hover .card-arrow {
    opacity: 1;
  }
  .card-arrow-left {
    left: 8px;
  }
  .card-arrow-right {
    right: 8px;
  }
  .card-dots {
    position: absolute;
    bottom: 8px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 5px;
    z-index: 2;
  }
  .card-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
  }
  .card-dot.active {
    background: #fff;
  }
  .title-project {
    color: #f6f6f9;
    padding: 10px 10px;
    font-size: 25px;
    font-weight: 700;
  }
  .title-project::first-letter {
    text-transform: capitalize;
  }
  .title-technologies {
    color: #555555;
    font-size: 11px;
    font-family: monospace;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 5px 10px;
  }
  .description-project {
    padding: 0 10px;
    color: #a0a0a0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .description-project::first-letter {
    text-transform: capitalize;
  }
  .container-technologies {
    position: relative;
    display: flex;
    justify-content: start;
    padding: 10px 10px;
    column-gap: 20px;
    flex-wrap: wrap;
    color: white;
  }
  .container-link-project {
    position: relative;
    width: 100%;
    padding: 20px 10px;
    margin-top: auto;
  }
  .container-link-project a {
    text-decoration: none;
    padding: 8px 16px;
    background-color: #01be96;
    border-radius: 6px;
    color: #000;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .container-link-project a:hover {
    background-color: #00a882;
  }
</style>

<script>
  function initProjectCards() {
    document.querySelectorAll(".li-project").forEach((card) => {
      const imgs = Array.from(card.querySelectorAll(".card-media-img"));
      if (imgs.length <= 1) return;

      const dots = Array.from(card.querySelectorAll(".card-dot"));
      const left = card.querySelector(".card-arrow-left");
      const right = card.querySelector(".card-arrow-right");
      let current = 0;

      function show(index) {
        current = (index + imgs.length) % imgs.length;
        imgs.forEach((img, i) => (img.style.opacity = i === current ? "1" : "0"));
        dots.forEach((d, i) => d.classList.toggle("active", i === current));
      }

      function stop(e) {
        e.preventDefault();
        e.stopPropagation();
      }

      if (left) left.addEventListener("click", (e) => { stop(e); show(current - 1); });
      if (right) right.addEventListener("click", (e) => { stop(e); show(current + 1); });
      card.addEventListener("mouseleave", () => show(0));
    });
  }

  initProjectCards();
  document.addEventListener("astro:after-swap", initProjectCards);
</script>
