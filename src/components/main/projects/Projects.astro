---
import { projects } from "../../../const/const";
import Project from "./Project.astro";

const latestProjects = projects.slice(0, 3);
---

<section class="section-projects">
  <div class="linear-grandient-1"></div>
  <div class="container-projects">
    <h2 class="title-projects" id="projects">Projects</h2>
    <div>
      <ul class="ul-projects">
        {
          latestProjects.map(({ description, img, link, technologies, title }) => (
            <Project
              img={img}
              description={description}
              link={link}
              title={title}
              technologies={technologies}
            />
          ))
        }
      </ul>
    </div>
    <div class="view-all-row">
      <a class="btn-view-all" href="/projects">View all projects</a>
    </div>
  </div>
</section>

<style>
  .linear-grandient-1 {
    position: absolute;
    left: 0;
    top: 1px;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(1, 190, 150, 0.5), #000);
    z-index: 0;
  }

  .section-projects {
    position: relative;
    background-color: #111111;
    overflow: hidden;
  }

  .container-projects {
    position: relative;
    width: 90%;
    margin: 0 auto;
    max-width: 1355px;
  }
  .title-projects {
    position: relative;
    display: block;
    font-size: 27px;
    padding: 20px 0;
    color: #f6f6f9;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
  }

  .ul-projects {
  position: relative;
  display: grid;
  width: 100%;
  padding: 40px 0;
  list-style: none;
}
  .ul-projects a {
    text-decoration: none;
  }

  .view-all-row {
    display: flex;
    justify-content: center;
    padding-bottom: 40px;
  }

  .btn-view-all {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    color: rgba(246, 246, 249, 0.92);
    border: 1px solid rgba(246, 246, 249, 0.18);
    transition: transform 0.12s ease;
  }

  .btn-view-all:hover {
    transform: translateY(-1px);
  }

  /* responsive */

  @media (min-width: 300px) {
    .ul-projects {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
  @media (min-width: 700px) {
    .ul-projects {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }
  @media (min-width: 1200px) {
    .ul-projects {
      grid-template-columns: repeat(3, 1fr);
      justify-content: space-between;
    }
  }
</style>
