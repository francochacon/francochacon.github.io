---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import Studies from "../studies/Studies.astro";
import Skills from "../skills/Skills.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section-about">
  <div class="linear-gradient-about"></div>
  <div class="container-about">
    <div class="container-text-about">
      <span class="badge">
        <span class="badge-dot"></span>
        {t("about.badge")}
      </span>
      <h2 class="title-about" id="about">{t("about.title")} <span class="accent">{t("about.titleAccent")}</span></h2>
      <div class="divider"></div>
      <div class="paragraphs">
        <p>{t("about.p1Before")} <strong>{t("about.p1Strong")}</strong> {t("about.p1After")} <strong>{t("about.p1StrongEnd")}</strong>.</p>
        <p>{t("about.p2Before")} <strong>{t("about.p2Strong")}</strong> {t("about.p2After")}</p>
        <p>{t("about.p3Before")} <strong>{t("about.p3Strong")}</strong> {t("about.p3After")}</p>
      </div>
      <div class="tools">
        <span class="tool">Power BI</span>
        <span class="tool">Excel</span>
        <span class="tool">Python</span>
        <span class="tool">SQL</span>
        <span class="tool">DAX</span>
        <span class="tool">SAP</span>
      </div>
      <div class="location">
        <span class="loc-dot"></span>
        {t("about.location")}
      </div>
    </div>

    <div class="container-svg-about">
      <div class="container-svg">
        <lottie-player
          src="https://assets8.lottiefiles.com/packages/lf20_sg18igu8.json"
          background="transparent"
          speed="1"
          style="width: 260px; height: 260px; position:relative;"
          loop
          autoplay></lottie-player>
      </div>

      <div class="stats-block">
        <p class="stats-title">{t("about.statsTitle")}</p>
        <div class="stat-grid">
          <div class="stat-card">
            <span class="stat-value">{t("about.stat1value")}</span>
            <span class="stat-label">{t("about.stat1label")}</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">{t("about.stat3value")}</span>
            <span class="stat-label">{t("about.stat3label")}</span>
            <span class="stat-sub">{t("about.stat3sub")}</span>
          </div>
          <div class="stat-card stat-card--wide">
            <span class="stat-value">{t("about.stat2value")}</span>
            <span class="stat-label">{t("about.stat2label")}</span>
            <span class="stat-sub">{t("about.stat2sub")}</span>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Certificates carousel -->
  <div class="certs-section">
    <p class="certs-label">{lang === "es" ? "Certificaciones" : "Certifications"}</p>
    <div class="certs-track-wrap">
      <div class="certs-track">
        <!-- cert 1 -->
        <div class="cert-card">
          <div class="cert-icon">🎓</div>
          <div class="cert-body">
            <p class="cert-name">{lang === "es" ? "Inglés A2" : "English A2"}</p>
            <p class="cert-issuer">Cambridge Assessment</p>
            <span class="cert-badge">A2</span>
          </div>
        </div>
        <!-- placeholder for future certs — duplicated for seamless loop -->
        <div class="cert-card cert-placeholder">
          <div class="cert-icon">📜</div>
          <div class="cert-body">
            <p class="cert-name">{lang === "es" ? "Próximamente..." : "Coming soon..."}</p>
            <p class="cert-issuer">&nbsp;</p>
          </div>
        </div>
        <!-- duplicate for infinite loop -->
        <div class="cert-card">
          <div class="cert-icon">🎓</div>
          <div class="cert-body">
            <p class="cert-name">{lang === "es" ? "Inglés A2" : "English A2"}</p>
            <p class="cert-issuer">Cambridge Assessment</p>
            <span class="cert-badge">A2</span>
          </div>
        </div>
        <div class="cert-card cert-placeholder">
          <div class="cert-icon">📜</div>
          <div class="cert-body">
            <p class="cert-name">{lang === "es" ? "Próximamente..." : "Coming soon..."}</p>
            <p class="cert-issuer">&nbsp;</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container-substory">
    <Studies />
    <Skills />
  </div>
</section>
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

<style>
  .section-about { position: relative; background-color: #000000; overflow: hidden; }
  .linear-gradient-about {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    background: radial-gradient(at left center, rgba(1,190,150,0.35), transparent, transparent);
    z-index: 0; pointer-events: none;
  }
  .container-about {
    position: relative; z-index: 1; width: 90%; display: flex;
    margin: 0 auto; padding: 60px 0; max-width: 1355px; align-items: center; gap: 60px;
  }
  .container-text-about { flex: 1; display: flex; flex-direction: column; gap: 20px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(1,190,150,0.1); border: 1px solid #01be96;
    border-radius: 20px; padding: 5px 14px; width: fit-content;
    font-size: 12px; color: #01be96; font-family: monospace; letter-spacing: 0.05em;
  }
  .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #01be96; flex-shrink: 0; }
  .title-about { font-size: 32px; color: #f6f6f9; font-weight: 800; line-height: 1.15; scroll-margin-top: 80px; }
  .title-about .accent { color: #01be96; }
  .divider { width: 40px; height: 3px; background: #01be96; border-radius: 2px; }
  .paragraphs { display: flex; flex-direction: column; gap: 14px; }
  .paragraphs p { font-size: 15px; color: #a0a0a0; line-height: 1.75; letter-spacing: 0.3px; }
  .paragraphs p strong { color: #f6f6f9; font-weight: 500; }
  .tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .tool {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(1,190,150,0.3);
    border-radius: 6px; padding: 5px 12px; font-size: 12px; color: #a0a0a0; font-family: monospace;
  }
  .location { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #555555; }
  .loc-dot { width: 6px; height: 6px; border-radius: 50%; background: #01be96; flex-shrink: 0; }

  .container-svg-about { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .container-svg { display: flex; justify-content: center; align-items: center; }

  .stats-block { width: 100%; max-width: 320px; }
  .stats-title {
    font-size: 11px; font-family: monospace; color: #555;
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px;
  }
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .stat-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(1,190,150,0.2);
    border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 3px;
    transition: border-color 0.25s ease;
  }
  .stat-card:hover { border-color: rgba(1,190,150,0.55); }
  .stat-card--wide { grid-column: 1 / -1; }
  .stat-value { font-size: 26px; font-weight: 800; color: #01be96; line-height: 1; }
  .stat-label { font-size: 12px; color: #a0a0a0; font-family: monospace; }
  .stat-sub { font-size: 10px; color: #555; font-family: monospace; margin-top: 2px; }

  .container-substory {
    position: relative; z-index: 1; width: 90%; margin: 0 auto;
    max-width: 1355px; display: flex; flex-direction: column; gap: 50px; padding-bottom: 60px;
  }
  @media (max-width: 900px) {
    .container-about { flex-direction: column; padding: 40px 0; gap: 30px; }
    .container-svg-about { width: 100%; }
    .stats-block { max-width: 100%; }
  }

  /* ── Certificates carousel ── */
  .certs-section { margin: 0 0 40px; }
  .certs-label {
    font-size: 11px; font-family: monospace; color: #555;
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px;
  }
  .certs-track-wrap {
    overflow: hidden; position: relative;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .certs-track {
    display: flex; gap: 16px; width: max-content;
    animation: scroll-certs 18s linear infinite;
  }
  .certs-track:hover { animation-play-state: paused; }
  @keyframes scroll-certs {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .cert-card {
    display: flex; align-items: center; gap: 14px;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(1,190,150,0.2);
    border-radius: 14px; padding: 14px 20px; flex-shrink: 0; width: 220px;
    transition: border-color 0.25s ease;
  }
  .cert-card:hover { border-color: rgba(1,190,150,0.55); }
  .cert-placeholder { border-style: dashed; opacity: 0.45; }
  .cert-icon { font-size: 26px; flex-shrink: 0; }
  .cert-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .cert-name { font-size: 13px; font-weight: 700; color: #f6f6f9; margin: 0; white-space: nowrap; }
  .cert-issuer { font-size: 11px; color: #555; font-family: monospace; margin: 0; }
  .cert-badge {
    display: inline-block; margin-top: 4px; font-size: 10px; font-weight: 800;
    background: rgba(1,190,150,0.15); color: #01be96;
    border: 1px solid rgba(1,190,150,0.35); border-radius: 4px; padding: 1px 7px;
    width: fit-content; font-family: monospace;
  }
</style>
