---
import ProjectSkills from "./ProjectSkills.astro";

export interface ProjectReportData {
  title: string;
  leadParagraph: string;
  description: string;
  pills: string[];
  skills: { title: string; icon: string }[];
  githubUrl: string;
  powerBiUrl: string;
  metricsTitle: string;
  metrics: string[];
  dashboardTitle: string;
  dashboardIntro: string;
  insights: string[];
  iframeTitle: string;
  closingParagraph: string;
}

export interface Props {
  report: ProjectReportData;
}

const { report } = Astro.props;
---

<section class="section-about">
  <div class="linear-grandient-1"></div>

  <!-- Main intro container -->
  <div class="container-about">
    <div class="container-text-about">
      <h2 class="title-about" id="overview">{report.title}</h2>

      <p class="p-lead">{report.leadParagraph}</p>

      <p>{report.description}</p>

      <div class="pill-row" aria-label="Project stack">
        {report.pills.map((pill) => <span class="pill">{pill}</span>)}
      </div>

      <ProjectSkills skills={report.skills} />

      <div class="cta-row">
        <a
          class="btn-primary"
          href={report.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View repository on GitHub"
        >
          View repository
        </a>

        <a
          class="btn-secondary"
          href={report.powerBiUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open the report in Power BI"
        >
          Open report (Power BI)
        </a>

        <a class="btn-ghost" href="/" aria-label="Back to portfolio home">
          Back to portfolio
        </a>
      </div>

      <div class="metrics-box" aria-label="Key metrics included">
        <h3 class="metrics-title">{report.metricsTitle}</h3>
        <ul class="metrics-list">
          {report.metrics.map((metric) => <li>{metric}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Power BI section -->
  <div class="container-powerbi" id="dashboard">
    <h2 class="title-powerbi">{report.dashboardTitle}</h2>

    <p class="text-powerbi">{report.dashboardIntro}</p>

    <ul class="insights-list">
      {report.insights.map((insight) => <li>{insight}</li>)}
    </ul>

    <div class="iframe-wrap" aria-label="Embedded Power BI dashboard">
      <iframe
        title={report.iframeTitle}
        src={report.powerBiUrl}
        frameborder="0"
        allowfullscreen="true"
      ></iframe>
    </div>

    <p class="text-powerbi">{report.closingParagraph}</p>
  </div>
</section>

<style>
  .linear-grandient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, #000, rgba(1, 190, 150, 0.5));
    z-index: 0;
  }

  .section-about {
    position: relative;
    background-color: #111111;
    padding: 60px 0;
  }

  .container-about {
    position: relative;
    width: 90%;
    display: flex;
    margin: 0 auto;
    max-width: 1355px;
  }

  .container-text-about {
    position: relative;
    width: 65%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .title-about {
    position: relative;
    display: block;
    font-size: 28px;
    padding: 10px 0;
    color: #f6f6f9;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
  }

  .p-lead {
    font-size: 18px;
    color: rgba(246, 246, 249, 0.95);
    line-height: 1.7;
    letter-spacing: 0.2px;
  }

  .container-text-about p {
    font-size: 16.5px;
    color: rgba(246, 246, 249, 0.9);
    text-align: left;
    line-height: 1.7;
    letter-spacing: 0.2px;
    margin: 0;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .pill {
    border: 1px solid rgba(0, 191, 165, 0.35);
    color: rgba(246, 246, 249, 0.92);
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 13px;
    background: rgba(0, 191, 165, 0.08);
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
    align-items: center;
  }

  .btn-primary,
  .btn-secondary,
  .btn-ghost {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.12s ease, background 0.12s ease, border 0.12s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: #00bfa5;
    color: #0b0b0b;
  }

  .btn-secondary {
    background: transparent;
    color: rgba(246, 246, 249, 0.92);
    border: 1px solid rgba(246, 246, 249, 0.18);
  }

  .btn-ghost {
    background: rgba(246, 246, 249, 0.06);
    color: rgba(246, 246, 249, 0.92);
    border: 1px solid rgba(246, 246, 249, 0.08);
  }

  .btn-primary:hover,
  .btn-secondary:hover,
  .btn-ghost:hover {
    transform: translateY(-1px);
  }

  .metrics-box {
    margin-top: 14px;
    padding: 14px 14px 10px;
    border-radius: 14px;
    border: 1px solid rgba(246, 246, 249, 0.1);
    background: rgba(0, 0, 0, 0.25);
    max-width: 900px;
  }

  .metrics-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 800;
    color: rgba(246, 246, 249, 0.95);
    letter-spacing: 0.2px;
  }

  .metrics-list {
    margin: 0;
    padding-left: 18px;
    color: rgba(246, 246, 249, 0.85);
    line-height: 1.7;
    font-size: 14px;
  }

  .container-powerbi {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 1200px;
    text-align: center;
    margin: 70px auto 0;
  }

  .title-powerbi {
    font-size: 28px;
    color: #00bfa5;
    margin-bottom: 14px;
    font-weight: 800;
    text-shadow: 0 0 10px rgba(0, 255, 180, 0.25);
  }

  .text-powerbi {
    color: rgba(246, 246, 249, 0.9);
    font-size: 16.5px;
    line-height: 1.7;
    max-width: 900px;
    margin: 14px auto;
    text-align: center;
  }

  .insights-list {
    max-width: 900px;
    margin: 0 auto 18px;
    text-align: left;
    color: rgba(246, 246, 249, 0.9);
    line-height: 1.7;
    padding-left: 18px;
  }

  .insights-list li {
    margin: 6px 0;
  }

  .iframe-wrap {
    width: 100%;
    margin: 18px auto;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 15px rgba(0, 255, 180, 0.18);
    background: #0e0e0e;
  }

  .iframe-wrap iframe {
    width: 100%;
    height: 720px;
    border: 0;
    display: block;
  }

  @media (max-width: 900px) {
    .container-about {
      flex-direction: column;
    }

    .container-text-about {
      width: 100%;
    }

    .iframe-wrap iframe {
      height: 460px;
    }

    .btn-primary,
    .btn-secondary,
    .btn-ghost {
      width: 100%;
    }
  }
</style>
