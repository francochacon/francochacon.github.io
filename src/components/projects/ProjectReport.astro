---
import ProjectSkills from "./ProjectSkills.astro";
import ProjectGallery from "./ProjectGallery.astro";
import Project from "../main/projects/Project.astro";
import { projects } from "../../const/const";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export interface ProjectReportData {
  title: string;
  leadParagraph: string;
  description: string;
  pills: string[];
  skills: { title: string; icon: string }[];
  images: string[];
  githubUrl: string;
  powerBiUrl: string;
  metricsTitle: string;
  metrics: string[];
  dashboardTitle: string;
  iframeTitle: string;
  closingParagraph: string;
}

export interface Props {
  report: ProjectReportData;
  currentLink: string;
}

const { report, currentLink } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === "es" ? "/es" : "/";
const moreProjects = projects[lang].filter((p) => p.link !== currentLink).slice(0, 2);
---

<section class="section-about">
  <div class="linear-grandient-1"></div>

  <!-- Gallery -->
  <div class="container-gallery">
    <ProjectGallery images={report.images} title={report.title} />
  </div>

  <!-- Main intro container -->
  <div class="container-about">
    <div class="container-text-about">
      <h2 class="title-about" id="overview">{report.title}</h2>

      <p class="p-lead">{report.leadParagraph}</p>

      <p>{report.description}</p>

      <div class="pill-row" aria-label="Project stack">
        {report.pills.map((pill) => <span class="pill">{pill}</span>)}
      </div>

      <ProjectSkills skills={report.skills} />

      <div class="cta-row">
        {report.githubUrl && (
          <a
            class="btn-primary"
            href={report.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View repository on GitHub"
          >
            {t("report.viewRepository")}
          </a>
        )}

        {report.powerBiUrl && (
          <a
            class="btn-secondary"
            href={report.powerBiUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open the report in Power BI"
          >
            {t("report.openReport")}
          </a>
        )}

        <a class="btn-ghost" href={homeHref} aria-label="Back to portfolio home">
          {t("report.backToPortfolio")}
        </a>
      </div>

      <div class="metrics-box" aria-label="Key metrics included">
        <h3 class="metrics-title">{report.metricsTitle}</h3>
        <ul class="metrics-list">
          {report.metrics.map((metric) => <li>{metric}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Power BI section -->
  <div class="container-powerbi" id="dashboard">
    <h2 class="title-powerbi">{report.dashboardTitle}</h2>

    {report.powerBiUrl && (
      <div class="iframe-wrap" aria-label="Embedded Power BI dashboard">
        <iframe
          title={report.iframeTitle}
          src={report.powerBiUrl}
          frameborder="0"
          allowfullscreen="true"
        ></iframe>
      </div>
    )}

    <p class="text-powerbi">{report.closingParagraph}</p>
  </div>

  <!-- Sticky services panel -->
  <aside class="services-sticky" id="services-sticky" aria-label="Services panel">
    <div class="ss-inner">
      <button class="ss-close" id="ss-close-btn" aria-label="Close panel">✕</button>
      <p class="ss-eyebrow">💼 {lang === "es" ? "¿Te interesa algo así?" : "Interested in this?"}</p>
      <h3 class="ss-title">{lang === "es" ? "Mis servicios" : "My services"}</h3>
      <div class="ss-items">
        <div class="ss-item">
          <span class="ss-icon">📊</span>
          <div>
            <p class="ss-name">{lang === "es" ? "Dashboard Power BI" : "Power BI Dashboard"}</p>
            <p class="ss-price">{lang === "es" ? "desde $120" : "from $120"}</p>
          </div>
        </div>
        <div class="ss-item">
          <span class="ss-icon">🏭</span>
          <div>
            <p class="ss-name">{lang === "es" ? "Dashboard Industrial" : "Industrial Dashboard"}</p>
            <p class="ss-price">{lang === "es" ? "desde $250" : "from $250"}</p>
          </div>
        </div>
        <div class="ss-item">
          <span class="ss-icon">🧹</span>
          <div>
            <p class="ss-name">{lang === "es" ? "Limpieza de datos" : "Data Cleaning"}</p>
            <p class="ss-price">{lang === "es" ? "desde $60" : "from $60"}</p>
          </div>
        </div>
      </div>
      <a href={lang === "es" ? "/es/services" : "/services"} class="ss-cta">
        {lang === "es" ? "Ver servicios completos →" : "See all services →"}
      </a>
    </div>
  </aside>

  {
    moreProjects.length > 0 && (
      <div class="container-more-projects">
        <h3 class="more-projects-title">{t("projects.moreProjects")}</h3>
        <ul class="more-projects-row">
          {moreProjects.map(({ description, images, link, technologies, title, tags }) => (
            <Project
              images={images}
              description={description}
              link={link}
              title={title}
              technologies={technologies}
              tags={tags}
            />
          ))}
        </ul>
      </div>
    )
  }
<script>
  const closeBtn = document.getElementById('ss-close-btn');
  const panel = document.getElementById('services-sticky');
  if (closeBtn && panel) {
    closeBtn.addEventListener('click', () => {
      panel.style.display = 'none';
    });
  }
</script>
</section>

<style>
  .linear-grandient-1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, #000, rgba(1, 190, 150, 0.5));
    z-index: 0;
  }

  .section-about {
    position: relative;
    background-color: #111111;
    padding: 60px 0;
  }

  .container-gallery {
    position: relative;
    z-index: 1;
    width: 90%;
    margin: 0 auto 36px;
    max-width: 1355px;
  }

  .container-about {
    position: relative;
    width: 90%;
    display: flex;
    margin: 0 auto;
    max-width: 1355px;
  }

  .container-text-about {
    position: relative;
    width: 65%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .title-about {
    position: relative;
    display: block;
    font-size: 28px;
    padding: 10px 0;
    color: #f6f6f9;
    width: 100%;
    font-weight: 800;
    scroll-margin-top: 80px;
  }

  .p-lead {
    font-size: 18px;
    color: rgba(246, 246, 249, 0.95);
    line-height: 1.7;
    letter-spacing: 0.2px;
  }

  .container-text-about p {
    font-size: 16.5px;
    color: rgba(246, 246, 249, 0.9);
    text-align: left;
    line-height: 1.7;
    letter-spacing: 0.2px;
    margin: 0;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .pill {
    border: 1px solid rgba(0, 191, 165, 0.35);
    color: rgba(246, 246, 249, 0.92);
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 13px;
    background: rgba(0, 191, 165, 0.08);
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
    align-items: center;
  }

  .btn-primary,
  .btn-secondary,
  .btn-ghost {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.12s ease, background 0.12s ease, border 0.12s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: #00bfa5;
    color: #0b0b0b;
  }

  .btn-secondary {
    background: transparent;
    color: rgba(246, 246, 249, 0.92);
    border: 1px solid rgba(246, 246, 249, 0.18);
  }

  .btn-ghost {
    background: rgba(246, 246, 249, 0.06);
    color: rgba(246, 246, 249, 0.92);
    border: 1px solid rgba(246, 246, 249, 0.08);
  }

  .btn-primary:hover,
  .btn-secondary:hover,
  .btn-ghost:hover {
    transform: translateY(-1px);
  }

  .metrics-box {
    margin-top: 14px;
    padding: 14px 14px 10px;
    border-radius: 14px;
    border: 1px solid rgba(246, 246, 249, 0.1);
    background: rgba(0, 0, 0, 0.25);
    max-width: 900px;
  }

  .metrics-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 800;
    color: rgba(246, 246, 249, 0.95);
    letter-spacing: 0.2px;
  }

  .metrics-list {
    margin: 0;
    padding-left: 18px;
    color: rgba(246, 246, 249, 0.85);
    line-height: 1.7;
    font-size: 14px;
  }

  .container-powerbi {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 1200px;
    text-align: center;
    margin: 70px auto 0;
  }

  .title-powerbi {
    font-size: 28px;
    color: #00bfa5;
    margin-bottom: 14px;
    font-weight: 800;
    text-shadow: 0 0 10px rgba(0, 255, 180, 0.25);
  }

  .text-powerbi {
    color: rgba(246, 246, 249, 0.9);
    font-size: 16.5px;
    line-height: 1.7;
    max-width: 900px;
    margin: 14px auto;
    text-align: center;
  }

  .iframe-wrap {
    width: 100%;
    margin: 18px auto;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 15px rgba(0, 255, 180, 0.18);
    background: #0e0e0e;
  }

  .iframe-wrap iframe {
    width: 100%;
    height: 720px;
    border: 0;
    display: block;
  }

  .container-more-projects {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 1355px;
    margin: 80px auto 0;
  }

  .more-projects-title {
    font-size: 20px;
    color: #f6f6f9;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .more-projects-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    list-style: none;
  }

  .ss-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    color: #f6f6f9;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease;
    line-height: 1;
  }
  .ss-close:hover {
    background: rgba(214,69,91,0.2);
    border-color: rgba(214,69,91,0.5);
    color: #D6455B;
  }

  /* ── Sticky services panel ── */
  .services-sticky {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 210px;
    z-index: 50;
    pointer-events: auto;
  }

  .ss-inner {
    background: rgba(10, 10, 10, 0.92);
    border: 1px solid rgba(1, 190, 150, 0.3);
    border-radius: 16px;
    padding: 18px 16px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }

  .ss-eyebrow {
    font-size: 10px;
    color: #01be96;
    font-family: monospace;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
  }

  .ss-title {
    font-size: 14px;
    font-weight: 800;
    color: #f6f6f9;
    margin: 0;
    line-height: 1.2;
  }

  .ss-items {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ss-item {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .ss-icon {
    font-size: 18px;
    flex-shrink: 0;
  }

  .ss-name {
    font-size: 11.5px;
    font-weight: 600;
    color: #f6f6f9;
    margin: 0;
    line-height: 1.2;
  }

  .ss-price {
    font-size: 10.5px;
    color: #01be96;
    font-family: monospace;
    font-weight: 700;
    margin: 2px 0 0;
  }

  .ss-cta {
    display: block;
    background: #01be96;
    color: #000;
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    padding: 10px 12px;
    border-radius: 10px;
    text-align: center;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .ss-cta:hover {
    background: #00a882;
    transform: translateY(-1px);
  }

  @media (max-width: 1300px) {
    .services-sticky { display: none; }
  }

  @media (max-width: 900px) {
    .container-about {
      flex-direction: column;
    }

    .container-text-about {
      width: 100%;
    }

    .iframe-wrap iframe {
      height: 460px;
    }

    .btn-primary,
    .btn-secondary,
    .btn-ghost {
      width: 100%;
    }
  }
</style>
