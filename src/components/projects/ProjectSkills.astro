---
import { getIconComponent } from "../../icons/IconAll.astro";

export interface Props {
  skills: { title: string; icon: string }[];
}
const { skills } = Astro.props;
---

<div class="project-skills" aria-label="Built with">
  <span class="project-skills-label">Built with</span>
  <ul class="project-skills-list">
    {
      skills.map(({ icon, title }) => {
        const IconComponent = getIconComponent(icon);
        return (
          <li class="project-skill-item">
            {IconComponent && <IconComponent />}
            <span>{title}</span>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .project-skills {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .project-skills-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #555555;
    font-family: monospace;
  }

  .project-skills-list {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-skill-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(246, 246, 249, 0.85);
    font-size: 13px;
  }

  .project-skill-item :global(svg),
  .project-skill-item :global(i) {
    width: 24px;
    height: 24px;
    display: inline-flex;
  }
</style>
