---
import Header from "../../components/header/Header.astro";
import Footer from "../../components/footer/Footer.astro";
import "../../style/index.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Servicios de análisis de datos y dashboards en Power BI por Franco Chacón — Ingeniero Químico especializado en datos industriales y minería." />
    <meta property="og:title" content="Servicios | Franco Chacón" />
    <meta property="og:image" content="https://francochacon.github.io/img/preview-page.webp" />
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
    <title>Servicios | Franco Chacón</title>
  </head>
  <body>
    <Header />
    <main class="services-main">

      <!-- Hero -->
      <section class="services-hero">
        <div class="services-hero-inner">
          <span class="badge-pill">Disponible para trabajo freelance</span>
          <h1 class="services-title">Qué puedo <span class="accent">construirte</span></h1>
          <p class="services-subtitle">Dashboards en Power BI y análisis de datos con contexto de ingeniería industrial — para clientes de minería, O&G e industria pesada que necesitan más que un gráfico bonito.</p>
          <div class="hero-ctas">
            <a href="https://www.upwork.com/freelancers/~01c688bcf95e6b2de2" target="_blank" rel="noopener noreferrer" class="btn-hire btn-upwork">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.546-1.405 0-2.543-1.14-2.543-2.546V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.439-5.439-5.439z"/></svg>
              Contratame en Upwork
            </a>
            <a href="https://es.fiverr.com/s/xX19qQZ" target="_blank" rel="noopener noreferrer" class="btn-hire btn-fiverr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.004 15.588a.995.995 0 1 0 .002-1.99.995.995 0 0 0-.002 1.99zm-.996-3.705h-1.39c-.445 0-.701-.19-.701-.698V8.763h2.09V7.25h-2.09V5h-1.744v8.251c0 1.34.848 2.133 2.15 2.133h1.685v-3.5zm-5.21-4.785v-.006c0-.957-.768-1.727-1.714-1.727H9.975v1.745h4.418c.315 0 .57.258.57.572v.001c0 .314-.255.571-.57.571H9.975v1.722h4.418c.315 0 .57.258.57.572v.001c0 .315-.255.572-.57.572h-4.418V14.5h4.109c1.946 0 3.524-1.59 3.524-3.552v-.85zM0 24V0h24v24z"/></svg>
              Buscame en Fiverr
            </a>
            <a href="https://wa.me/+543875633214" target="_blank" rel="noopener noreferrer" class="btn-hire btn-wa">
              <i class="fa-brands fa-whatsapp"></i>
              WhatsApp
            </a>
            <a href="https://www.peopleperhour.com/freelancer/franco-chacon-chemical-engineer-data-analyst-zxwajwmw" target="_blank" rel="noopener noreferrer" class="btn-hire btn-pph">
              <i class="fa-solid fa-business-time"></i>
              Encontrame en PeoplePerHour
            </a>
          </div>
        </div>
      </section>

      <!-- Tarjetas de servicios -->
      <section class="services-grid-section">
        <div class="services-grid">

          <div class="svc-card">
            <div class="svc-icon">📊</div>
            <div class="svc-badge svc-badge--popular">Más solicitado</div>
            <h2 class="svc-title">Dashboard en Power BI</h2>
            <p class="svc-desc">Reporte interactivo con KPIs, gráficos de tendencia y filtros drill-down. Conectado a tu fuente de datos — Excel, SQL o CSV. Entregado como archivo .pbix listo para publicar.</p>
            <ul class="svc-includes">
              <li>Hasta 3 páginas de reporte</li>
              <li>Modelo de datos + limpieza en Power Query</li>
              <li>Medidas DAX para tus KPIs</li>
              <li>1 ronda de revisión incluida</li>
            </ul>
            <div class="svc-price">
              <span class="price-from">desde</span>
              <span class="price-value">$120</span>
            </div>
            <a href="https://www.upwork.com/services/product/development-it-i-will-create-a-professional-power-bi-dashboard-from-your-excel-or-csv-data-2023533176629273237" target="_blank" rel="noopener noreferrer" class="svc-cta">Solicitar en Upwork →</a>
          </div>

          <div class="svc-card svc-card--soon">
            <div class="svc-icon">🏭</div>
            <h2 class="svc-title">Dashboard Industrial / Minería</h2>
            <p class="svc-desc">Dashboard especializado para operaciones mineras, O&G o industriales — KPIs de producción, indicadores ambientales, rendimiento de equipos o analítica de inventario. Construido con conocimiento del dominio, no solo gráficos.</p>
            <ul class="svc-includes">
              <li>Hasta 5 páginas de reporte</li>
              <li>Modelo de datos completo desde datos crudos</li>
              <li>Diseño de KPIs específico por industria</li>
              <li>2 rondas de revisión incluidas</li>
            </ul>
            <div class="svc-price">
              <span class="price-from">desde</span>
              <span class="price-value">$250</span>
            </div>
            <span class="svc-cta svc-cta--disabled">Próximamente</span>
          </div>

          <div class="svc-card">
            <div class="svc-icon">🧹</div>
            <h2 class="svc-title">Limpieza y Análisis de Datos</h2>
            <p class="svc-desc">Datos crudos en Excel, CSV o SQL que necesitan estructura antes de poder analizarse. Los limpio, normalizo y resumo — y entrego un dataset listo para usar más un informe escrito con los hallazgos.</p>
            <ul class="svc-includes">
              <li>Python o Excel / Power Query</li>
              <li>Detección de duplicados y errores</li>
              <li>Dataset estructurado + informe de resultados</li>
            </ul>
            <div class="svc-price">
              <span class="price-from">desde</span>
              <span class="price-value">$60</span>
            </div>
            <a href="https://es.fiverr.com/s/lja4A2g" target="_blank" rel="noopener noreferrer" class="svc-cta">Pedir en Fiverr →</a>
          </div>

          <div class="svc-card">
            <div class="svc-icon">📦</div>
            <h2 class="svc-title">Analítica de Inventario y Stock</h2>
            <p class="svc-desc">Auditoría de datos de inventario + dashboard: normalización del estado de stock, detección de duplicados, verificación de compatibilidades y reporte de KPIs. Basado en experiencia real auditando más de 270 reactivos químicos.</p>
            <ul class="svc-includes">
              <li>Auditoría de calidad de datos</li>
              <li>Seguimiento de estado de stock y movimientos</li>
              <li>Dashboard en Power BI con filtros</li>
            </ul>
            <div class="svc-price">
              <span class="price-from">desde</span>
              <span class="price-value">$100</span>
            </div>
            <span class="svc-cta svc-cta--disabled">Próximamente</span>
          </div>

        </div>
      </section>

      <!-- Por qué yo -->
      <section class="why-section">
        <div class="why-inner">
          <h2 class="why-title">¿Por qué trabajar conmigo?</h2>
          <div class="why-grid">
            <div class="why-card">
              <span class="why-icon">⚗️</span>
              <h3>Formación en ingeniería</h3>
              <p>No solo visualizo datos — entiendo los procesos industriales detrás de ellos. Eso significa mejor diseño de KPIs y menos idas y vueltas innecesarias.</p>
            </div>
            <div class="why-card">
              <span class="why-icon">🎯</span>
              <h3>Resultado listo para decidir</h3>
              <p>Cada dashboard que armo está pensado para la persona que tiene que actuar sobre él, no solo leerlo. Claro, accionable y fácil de mantener.</p>
            </div>
            <div class="why-card">
              <span class="why-icon">🔍</span>
              <h3>Calidad de datos primero</h3>
              <p>Antes de construir cualquier visual, audito los datos. Registros duplicados, formatos inconsistentes y valores faltantes se corrigen antes de que se conviertan en problemas en el gráfico.</p>
            </div>
            <div class="why-card">
              <span class="why-icon">💬</span>
              <h3>Comunicación clara</h3>
              <p>Con base en Salta, Argentina, trabajando a nivel mundial. Respondo dentro de las 24 horas y te mantengo actualizado en cada paso — sin cajas negras.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Projects CTA -->
      <section class="projects-cta-section">
        <div class="projects-cta-inner">
          <p class="projects-cta-sub">¿Querés ver estos conceptos en acción?</p>
          <h2 class="projects-cta-title">Mirá mis proyectos</h2>
          <p class="projects-cta-desc">De dashboards para la industria minera a plataformas de inventario químico — proyectos reales construidos con las mismas herramientas y metodología que describí arriba.</p>
          <a href="/es/projects" class="projects-cta-btn">Ver todos los proyectos →</a>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  body { background: #000; color: #f6f6f9; font-family: 'Inter', sans-serif; margin: 0; }

  .services-hero {
    background: radial-gradient(ellipse at top right, rgba(1,190,150,0.18), transparent 60%), #000;
    padding: 80px 0 60px;
  }
  .services-hero-inner { width: 90%; max-width: 860px; margin: 0 auto; }
  .badge-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(1,190,150,0.1); border: 1px solid #01be96;
    border-radius: 20px; padding: 5px 14px; font-size: 12px; color: #01be96;
    font-family: monospace; letter-spacing: 0.05em; margin-bottom: 24px;
  }
  .services-title { font-size: clamp(28px, 5vw, 46px); font-weight: 800; line-height: 1.15; margin: 0 0 18px; }
  .accent { color: #01be96; }
  .services-subtitle { font-size: 17px; color: #a0a0a0; line-height: 1.75; max-width: 640px; margin-bottom: 36px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-hire {
    display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
    font-size: 14px; font-weight: 700; padding: 12px 22px; border-radius: 12px;
    border: 1px solid transparent; transition: all 0.2s ease;
  }
  .btn-hire:hover { transform: translateY(-2px); }
  .btn-upwork { background: rgba(20,164,78,0.15); color: #14a44e; border-color: rgba(20,164,78,0.4); }
  .btn-fiverr { background: rgba(26,182,112,0.15); color: #1ab670; border-color: rgba(26,182,112,0.4); }
  .btn-wa { background: rgba(37,211,102,0.1); color: #25d366; border-color: rgba(37,211,102,0.35); }
  .btn-pph { background: rgba(255,115,0,0.12); color: #ff7300; border-color: rgba(255,115,0,0.4); }

  .services-grid-section { width: 90%; max-width: 1200px; margin: 0 auto; padding: 60px 0; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }

  .svc-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px; padding: 28px 26px; position: relative;
    display: flex; flex-direction: column; gap: 14px;
    transition: border-color 0.25s ease, transform 0.2s ease;
  }
  .svc-card:hover { border-color: rgba(1,190,150,0.4); transform: translateY(-3px); }
  .svc-card--soon { opacity: 0.55; }
  .svc-card--soon:hover { border-color: rgba(255,255,255,0.08); transform: none; }
  .svc-icon { font-size: 28px; }
  .svc-badge {
    position: absolute; top: 20px; right: 20px;
    font-size: 10px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; letter-spacing: 0.04em;
  }
  .svc-badge--popular { background: rgba(1,190,150,0.15); color: #01be96; border: 1px solid rgba(1,190,150,0.4); }
  .svc-title { font-size: 18px; font-weight: 700; margin: 0; }
  .svc-desc { font-size: 13.5px; color: #a0a0a0; line-height: 1.7; margin: 0; }
  .svc-includes { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; flex: 1; }
  .svc-includes li { font-size: 13px; color: #707070; padding-left: 16px; position: relative; }
  .svc-includes li::before { content: "✓"; position: absolute; left: 0; color: #01be96; font-weight: 700; }
  .svc-price { display: flex; align-items: baseline; gap: 6px; margin-top: 4px; }
  .price-from { font-size: 12px; color: #555; font-family: monospace; }
  .price-value { font-size: 28px; font-weight: 800; color: #01be96; font-family: monospace; }
  .svc-cta {
    display: inline-block; text-decoration: none; font-size: 13px; font-weight: 700;
    color: #01be96; border: 1px solid rgba(1,190,150,0.35); border-radius: 9px;
    padding: 10px 16px; text-align: center; transition: all 0.2s ease;
  }
  .svc-cta:hover { background: rgba(1,190,150,0.1); }
  .svc-cta--disabled {
    display: inline-block; text-decoration: none; font-size: 13px; font-weight: 700;
    color: #555; border: 1px solid rgba(255,255,255,0.08); border-radius: 9px;
    padding: 10px 16px; text-align: center; cursor: default; background: rgba(255,255,255,0.03);
  }

  .why-section { background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.06); padding: 70px 0; }
  .why-inner { width: 90%; max-width: 1200px; margin: 0 auto; }
  .why-title { font-size: 28px; font-weight: 800; margin-bottom: 36px; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .why-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px; padding: 24px 22px; display: flex; flex-direction: column; gap: 10px;
  }
  .why-icon { font-size: 24px; }
  .why-card h3 { font-size: 15px; font-weight: 700; margin: 0; }
  .why-card p { font-size: 13.5px; color: #a0a0a0; line-height: 1.65; margin: 0; }

  @media (max-width: 600px) {
    .services-hero { padding: 100px 0 50px; }
    .hero-ctas { flex-direction: column; }
  }

  .projects-cta-section {
    background: linear-gradient(135deg, rgba(1,190,150,0.08), rgba(1,190,150,0.02));
    border-top: 1px solid rgba(1,190,150,0.2);
    padding: 70px 0;
  }
  .projects-cta-inner {
    width: 90%; max-width: 700px; margin: 0 auto; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
  }
  .projects-cta-sub {
    font-size: 12px; font-family: monospace; color: #01be96;
    text-transform: uppercase; letter-spacing: 0.1em; margin: 0;
  }
  .projects-cta-title {
    font-size: 32px; font-weight: 800; margin: 0; line-height: 1.2;
  }
  .projects-cta-desc {
    font-size: 15px; color: #a0a0a0; line-height: 1.7;
    max-width: 560px; margin: 0;
  }
  .projects-cta-btn {
    display: inline-block; margin-top: 8px; text-decoration: none;
    background: #01be96; color: #000; font-weight: 800; font-size: 15px;
    padding: 14px 32px; border-radius: 12px;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .projects-cta-btn:hover { background: #00a882; transform: translateY(-2px); }
</style>
