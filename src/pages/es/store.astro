---
import Header from "../../components/header/Header.astro";
import Footer from "../../components/footer/Footer.astro";
import "../../style/index.css"; 
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Plantillas de dashboard en Power BI y herramientas de datos por Franco Chacón — ready-to-use reports for mining, industrial operations and retail." />
    <meta property="og:title" content="Tienda | Franco Chacón" />
    <meta property="og:image" content="https://francochacon.github.io/img/preview-page.webp" />
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
    <title>Tienda | Franco Chacón</title>
  </head>
  <body>
    <Header />
    <main class="store-main">

      <section class="store-hero">
        <div class="store-hero-inner">
          <span class="badge-pill">🛍️ Plantillas y Herramientas</span>
          <h1 class="store-title">Plantillas de <span class="accent">dashboard listas para usar</span></h1>
          <p class="store-subtitle">Descargá plantillas profesionales de Power BI construidas para casos de uso industriales y de negocio reales. Comprás una vez, adaptás a tus datos y desplegás en minutos.</p>
        </div>
      </section>

      <section class="store-grid-section">
        <div class="store-grid">

          <div class="store-card">
            <div class="store-img-wrap">
              <img src="/img/mining-projects-map.webp" alt="Mining Dashboard Template" class="store-img"/>
              <span class="store-tag">Power BI</span>
            </div>
            <div class="store-body">
              <h2 class="store-name">Dashboard de Operaciones Mineras</h2>
              <p class="store-desc">KPI template for mining operations: production tracking, regional breakdown and mineral concentration. Adaptable to any dataset.</p>
              <div class="store-meta">
                <span class="store-price">$25</span>
                <a href="https://www.etsy.com" target="_blank" rel="noopener noreferrer" class="store-btn store-btn--etsy">
                  Comprar en Etsy →
                </a>
              </div>
            </div>
          </div>

          <div class="store-card">
            <div class="store-img-wrap">
              <img src="/img/superstore-dashboard.webp" alt="Sales Dashboard Template" class="store-img"/>
              <span class="store-tag">Power BI</span>
            </div>
            <div class="store-body">
              <h2 class="store-name">Dashboard de Performance de Ventas</h2>
              <p class="store-desc">Multi-page sales report with revenue trend, regional breakdown and top product analysis. Works with any transactional dataset.</p>
              <div class="store-meta">
                <span class="store-price">$20</span>
                <a href="https://www.etsy.com" target="_blank" rel="noopener noreferrer" class="store-btn store-btn--etsy">
                  Comprar en Etsy →
                </a>
              </div>
            </div>
          </div>

          <div class="store-card store-card--soon">
            <div class="store-img-wrap store-img-soon">
              <span class="soon-icon">⚗️</span>
            </div>
            <div class="store-body">
              <h2 class="store-name">Dashboard de Inventario Químico</h2>
              <p class="store-desc">Full inventory management template with compatibility matrix, stock status and audit trail. Coming once the Power BI build is complete.</p>
              <div class="store-meta">
                <span class="store-price soon-price">Próximamente</span>
                <span class="store-btn store-btn--disabled">Avisarme</span>
              </div>
            </div>
          </div>

          <div class="store-card store-card--soon">
            <div class="store-img-wrap store-img-soon">
              <span class="soon-icon">🏭</span>
            </div>
            <div class="store-body">
              <h2 class="store-name">Plantilla de KPIs Ambientales</h2>
              <p class="store-desc">Sustainability KPI dashboard tracking valorization rates, emissions and environmental indicators. Based on the TotalEnergies project.</p>
              <div class="store-meta">
                <span class="store-price soon-price">Próximamente</span>
                <span class="store-btn store-btn--disabled">Avisarme</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <section class="store-platforms">
        <div class="store-platforms-inner">
          <p class="platforms-label">Encontrá mis plantillas en</p>
          <div class="platforms-row">
            <a href="https://www.etsy.com" target="_blank" rel="noopener noreferrer" class="platform-card">
              <span class="platform-icon">🛒</span>
              <div>
                <p class="platform-name">Etsy</p>
                <p class="platform-sub">Plantillas y descargas digitales</p>
              </div>
            </a>
            <div class="platform-card platform-card--soon">
              <span class="platform-icon">📦</span>
              <div>
                <p class="platform-name">Gumroad</p>
                <p class="platform-sub">Próximamente</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="store-custom">
        <div class="store-custom-inner">
          <h2 class="store-custom-title">¿Necesitás algo personalizado?</h2>
          <p class="store-custom-desc">Las plantillas son un punto de partida. Si necesitás un dashboard construido desde cero para tus datos y procesos específicos, mirá mis servicios.</p>
          <a href="/es/services" class="store-custom-btn">Ver servicios →</a>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  body { background: #000; color: #f6f6f9; font-family: 'Inter', sans-serif; margin: 0; }
  .store-hero {
    background: radial-gradient(ellipse at top left, rgba(1,190,150,0.15), transparent 55%), #000;
    padding: 80px 0 60px;
  }
  .store-hero-inner { width: 90%; max-width: 860px; margin: 0 auto; }
  .badge-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(1,190,150,0.1); border: 1px solid #01be96;
    border-radius: 20px; padding: 5px 14px; font-size: 12px; color: #01be96;
    font-family: monospace; letter-spacing: 0.05em; margin-bottom: 24px;
  }
  .store-title { font-size: clamp(26px,5vw,44px); font-weight: 800; line-height: 1.15; margin: 0 0 16px; }
  .accent { color: #01be96; }
  .store-subtitle { font-size: 16px; color: #a0a0a0; line-height: 1.75; max-width: 580px; margin: 0; }

  .store-grid-section { width: 90%; max-width: 1200px; margin: 0 auto; padding: 60px 0 40px; }
  .store-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 22px; }

  .store-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px; overflow: hidden;
    transition: border-color 0.25s ease, transform 0.2s ease;
    display: flex; flex-direction: column;
  }
  .store-card:hover { border-color: rgba(1,190,150,0.4); transform: translateY(-3px); }
  .store-card--soon { opacity: 0.65; }
  .store-card--soon:hover { transform: none; border-color: rgba(255,255,255,0.1); }

  .store-img-wrap { position: relative; height: 160px; overflow: hidden; background: #0a0a0a; }
  .store-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .store-tag {
    position: absolute; top: 10px; left: 10px;
    background: rgba(1,190,150,0.85); color: #000;
    font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 6px;
  }
  .store-img-soon {
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.02);
  }
  .soon-icon { font-size: 48px; opacity: 0.4; }

  .store-body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .store-name { font-size: 16px; font-weight: 700; margin: 0; }
  .store-desc { font-size: 13px; color: #a0a0a0; line-height: 1.65; margin: 0; flex: 1; }
  .store-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
  .store-price { font-size: 22px; font-weight: 800; color: #01be96; font-family: monospace; }
  .soon-price { font-size: 13px; color: #555; font-family: monospace; font-weight: 600; }
  .store-btn {
    text-decoration: none; font-size: 12px; font-weight: 700; padding: 9px 16px;
    border-radius: 9px; border: 1px solid transparent; transition: all 0.2s ease;
  }
  .store-btn--etsy { background: rgba(241,100,35,0.15); color: #f16423; border-color: rgba(241,100,35,0.4); }
  .store-btn--etsy:hover { background: rgba(241,100,35,0.25); }
  .store-btn--disabled { background: rgba(255,255,255,0.04); color: #555; border-color: rgba(255,255,255,0.08); cursor: default; }

  .store-platforms { padding: 50px 0; border-top: 1px solid rgba(255,255,255,0.06); }
  .store-platforms-inner { width: 90%; max-width: 700px; margin: 0 auto; }
  .platforms-label { font-size: 11px; font-family: monospace; color: #555; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 18px; }
  .platforms-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .platform-card {
    display: flex; align-items: center; gap: 12px; text-decoration: none;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 14px 18px; transition: border-color 0.2s ease;
  }
  .platform-card:hover { border-color: rgba(1,190,150,0.4); }
  .platform-card--soon { opacity: 0.4; cursor: default; }
  .platform-icon { font-size: 24px; }
  .platform-name { font-size: 14px; font-weight: 700; margin: 0; color: #f6f6f9; }
  .platform-sub { font-size: 11px; color: #555; margin: 2px 0 0; font-family: monospace; }

  .store-custom {
    background: linear-gradient(135deg, rgba(1,190,150,0.08), rgba(1,190,150,0.02));
    border-top: 1px solid rgba(1,190,150,0.2); padding: 70px 0;
  }
  .store-custom-inner { width: 90%; max-width: 640px; margin: 0 auto; text-align: center; }
  .store-custom-title { font-size: 28px; font-weight: 800; margin: 0 0 14px; }
  .store-custom-desc { font-size: 15px; color: #a0a0a0; line-height: 1.7; margin: 0 0 24px; }
  .store-custom-btn {
    display: inline-block; text-decoration: none; background: rgba(1,190,150,0.12);
    color: #01be96; font-weight: 700; font-size: 14px; padding: 12px 28px;
    border-radius: 12px; border: 1px solid rgba(1,190,150,0.35);
    transition: background 0.2s ease;
  }
  .store-custom-btn:hover { background: rgba(1,190,150,0.22); }

  @media (max-width: 600px) { .store-hero { padding: 100px 0 50px; } }
</style>
