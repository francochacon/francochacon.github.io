---
import Header from "../components/header/Header.astro";
import "../style/index.css";
import AllProjects from "../components/main/projects/AllProjects.astro";
import Footer from "../components/footer/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Browse the full collection of data analytics and business intelligence projects by Franco Chacón."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://francochacon.github.io/projects" />
    <meta property="og:site_name" content="Franco Chacón" />
    <meta property="og:title" content="All Projects | Franco Chacón" />
    <link rel="canonical" href="https://francochacon.github.io/projects" />
    <link rel="alternate" hreflang="en" href="https://francochacon.github.io/projects" />
    <link rel="alternate" hreflang="es" href="https://francochacon.github.io/es/projects" />
    <link rel="alternate" hreflang="x-default" href="https://francochacon.github.io/projects" />
    <meta
      property="og:image"
      content="https://francochacon.github.io/img/preview-page.webp"
    />

    <script
      src="https://kit.fontawesome.com/2898a0ac51.js"
      crossorigin="anonymous"></script>
    <title>All Projects | Franco Chacón</title>
  </head>
  <body>
    <Header />
    <main>
      <AllProjects />
    </main>
    <Footer />
  </body>
</html>
